/* FILE: AVIS/VERSION 1/RUNTIME/dispatch.runtime
   ROLE: DISPATCH_SYSTEM
   VERSION: 1
*/

BEGIN DISPATCH VERSION_1
    [DISPATCH_META]:
        VERSION: 1;
        EVENT_SYSTEM: "AVIS/VERSION 1/ENGINE/events.engine";

    [DISPATCH_LOOP]:
        WHILE TRUE:
            EVENT = EVENT_SYSTEM.NEXT();
            EVENT_SYSTEM.DISPATCH(EVENT);
END DISPATCH
