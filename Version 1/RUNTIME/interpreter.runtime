/* FILE: AVIS/VERSION 1/RUNTIME/interpreter.runtime
   ROLE: INTERPRETER_RUNTIME
   VERSION: 1
*/

BEGIN RUNTIME INTERPRETER_V1
    [RUNTIME_META]:
        VERSION: 1;
        HOOK_SYSTEM: "AVIS/VERSION 1/ENGINE/hooks.engine";
        EVENT_SYSTEM: "AVIS/VERSION 1/ENGINE/events.engine";

    [RUNTIME_BOOT]:
        LOAD_HOOKS(HOOK_SYSTEM);
        LOAD_EVENTS(EVENT_SYSTEM);
        SIGNAL EVENT_INIT;

    [RUNTIME_LOOP]:
        WHILE TRUE:
            EVENT = EVENT_SYSTEM.NEXT();
            HOOK_SYSTEM.PRE_HOOK(EVENT);
            EVENT_SYSTEM.DISPATCH(EVENT);
            HOOK_SYSTEM.POST_HOOK(EVENT);
END RUNTIME
