/* FILE: AVIS/VERSION 1/EXTENSIONS/loader.ext
   ROLE: EXTENSION_LOADER
   VERSION: 1
*/

BEGIN EXTENSION_LOADER VERSION_1
    [LOADER_META]:
        VERSION: 1;
        REGISTRY: "AVIS/VERSION 1/EXTENSIONS/registry.ext";

    [LOADER_OPS]:
        OP LOAD_ALL():
            EXT_LIST = REGISTRY.LIST_EXTENSIONS();
            FOR EACH EXT IN EXT_LIST:
                REGISTRY.LOAD_EXTENSION(EXT);

        OP LOAD_SINGLE(NAME):
            REGISTRY.LOAD_EXTENSION(NAME);
END EXTENSION_LOADER
