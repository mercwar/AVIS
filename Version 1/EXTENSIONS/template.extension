/* FILE: AVIS/VERSION 1/EXTENSIONS/template.extension
   ROLE: EXTENSION_TEMPLATE
   VERSION: 1
*/

BEGIN EXTENSION {{EXTENSION_NAME}}
    [EXT_META]:
        VERSION: 1;
        AUTHOR: {{AUTHOR}};
        DESCRIPTION: {{DESCRIPTION}};

    [EXT_HOOKS]:
        ON LOAD:
            LOG "EXTENSION {{EXTENSION_NAME}} LOADED";

        ON UNLOAD:
            LOG "EXTENSION {{EXTENSION_NAME}} UNLOADED";

    [EXT_OPS]:
        OP EXECUTE():
            LOG "EXTENSION {{EXTENSION_NAME}} EXECUTED";
END EXTENSION
