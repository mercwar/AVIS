/* FILE: AVIS/VERSION 1/MATRIX/schema.avis
   ROLE: MATRIX_SCHEMA
   VERSION: 1
*/

AVIS: AI VISIBILITY
FILE: MATRIX.SCHEMA.V1
OBJECT: HYPER_MATRIX
BATCH: CBORD_2026_ULTRA

BEGIN AVIS
    [MATRIX_META]:
        VERSION: 1;
        DIMENSIONS: 4;
        LAYERS: [1..99999];
        ENCODING: UTF-BIONIC;

    [MATRIX_COORDINATES]:
        AXIS_X: INT32;
        AXIS_Y: INT32;
        AXIS_Z: INT32;
        AXIS_T: INT64;  /* time / revision */

    [MATRIX_CELL]:
        PAYLOAD_TYPE: BIONIC_TEXT;
        MAX_PAYLOAD_SIZE: 4096 BYTES;
        FLAGS: { IMMUTABLE, ADDRESSABLE, INDEXED };

    [MATRIX_INDEX]:
        PRIMARY_INDEX: (AXIS_X, AXIS_Y, AXIS_Z, AXIS_T);
        SECONDARY_INDEX: (AXIS_T);
        SEARCH_MODE: RECURSIVE_DEEP;

    [MATRIX_BINDINGS]:
        BOUND_TO_INTERPRETER: "CYBORG-LANG";
        BOUND_TO_VERSION: 1;
        BOUND_TO_ENGINE: "CYBORG_ENGINE_V1";
END AVIS
