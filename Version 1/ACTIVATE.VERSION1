/* FILE: AVIS/VERSION 1/ACTIVATE.VERSION1
   ROLE: VERSION_ACTIVATION
   VERSION: 1
*/

BEGIN ACTIVATE VERSION_1
    [ACTIVATION_META]:
        VERSION: 1;
        STATE: PENDING;
        ENGINE: "CYBORG_ENGINE_V1";
        RUNTIME: "CORE_V1";
        MATRIX: "MATRIX_INSTANCE_V1";

    [ACTIVATION_SEQUENCE]:
        LOAD_BOOT("AVIS/VERSION 1/BOOT/init.boot");
        EXECUTE_BOOT();

        SET_ACTIVE_VERSION(1);
        SET_STATE(ACTIVE);

        LOG "VERSION_1_ACTIVATED";
END ACTIVATE
