/* FILE: AVIS/VERSION 1/RESOURCE/github.resource
   ROLE: REMOTE_RESOURCE_INDEX
   VERSION: 1
*/

REMOTE_PROVIDER: GITHUB
REMOTE_ROOT: "https://github.com/mercwar/AVIS"

BEGIN RESOURCE_MAP
    RESOURCE "AI.FVS"              -> PATH "/AI.FVS"
    RESOURCE "AVIS.FVS"            -> PATH "/AVIS/AVIS.FVS"
    RESOURCE "SCHEMA.CYBORG_MAX"   -> PATH "/SCHEMA/SCHEMA.CYBORG_MAX.AVIS"
    RESOURCE "INTERPRETER.REG"     -> PATH "/AVIS/VERSION 1/SCHEMA.AVIS_INTERPRETER.REG"
END RESOURCE_MAP

BEGIN RESOLUTION_RULES
    ON REQUEST(FILE_ID):
        LOOKUP FILE_ID IN RESOURCE_MAP;
        IF FOUND:
            RETURN REMOTE_ROOT + PATH;
        ELSE:
            RETURN ERROR "REMOTE_RESOURCE_NOT_FOUND";
END RESOLUTION_RULES
