/* FILE: AVIS/VERSION 1/VALIDATION/schema.val
   ROLE: SCHEMA_VALIDATION_RULES
   VERSION: 1
*/

BEGIN VALIDATION MATRIX_SCHEMA_V1
    RULE CHECK_DIMENSIONS:
        REQUIRE DIMENSIONS == 4;

    RULE CHECK_PAYLOAD_SIZE:
        REQUIRE MAX_PAYLOAD_SIZE <= 4096;

    RULE CHECK_INDEX:
        REQUIRE PRIMARY_INDEX EXISTS;
END VALIDATION
