/* FILE: AVIS/VERSION 1/TEMPLATES/registry.templates
   ROLE: TEMPLATE_REGISTRY
   VERSION: 1
*/

BEGIN TEMPLATE_REGISTRY VERSION_1
    [TEMPLATE_META]:
        VERSION: 1;
        MODE: STATIC;

    [TEMPLATE_TABLE]:
        TABLE:
            "MATRIX_TEMPLATE" -> "AVIS/VERSION 1/TEMPLATES/matrix.artifact";
            "INTERPRETER_TEMPLATE" -> "AVIS/VERSION 1/TEMPLATES/interpreter.artifact";

    [TEMPLATE_OPS]:
        OP GET_TEMPLATE(NAME):
            RETURN TABLE.GET(NAME);

        OP LIST_TEMPLATES():
            RETURN TABLE.LIST();
END TEMPLATE_REGISTRY
