/* FILE: AVIS/VERSION 1/TEMPLATES/matrix.artifact
   ROLE: MATRIX_TEMPLATE
   VERSION: 1
*/

AVIS: AI VISIBILITY
FILE: {{MATRIX_FILE_NAME}}
OBJECT: HYPER_MATRIX_INSTANCE
BATCH: CBORD_2026_ULTRA

BEGIN AVIS
    [MATRIX_INSTANCE_META]:
        VERSION: 1;
        ORIGIN: {{ORIGIN_TAG}};
        OWNER: {{OWNER_ID}};

    [MATRIX_BOUNDS]:
        LAYER_MIN: 1;
        LAYER_MAX: {{LAYER_MAX}};

    [MATRIX_PAYLOAD_PROFILE]:
        PAYLOAD_TYPE: BIONIC_TEXT;
        MAX_PAYLOAD_SIZE: 4096 BYTES;

    [MATRIX_LINK]:
        SCHEMA: "AVIS/VERSION 1/matrix/schema.avis";
        DEFS:   "AVIS/VERSION 1/DEFS/matrix.defs";
END AVIS
