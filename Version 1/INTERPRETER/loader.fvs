/* FILE: AVIS/VERSION 1/INTERPRETER/loader.fvs
   ROLE: INTERPRETER_LOADER
   VERSION: 1
*/

BEGIN INTERPRETER_LOADER
    TARGET_LANGUAGE: "CYBORG-LANG";
    MANIFEST_FILE: "AVIS/VERSION 1/SCHEMA.AVIS_INTERPRETER.REG";

    STEP 1: LOAD_FILE(MANIFEST_FILE);
    STEP 2: PARSE_AS(CYBORG_LANG_MANIFEST);
    STEP 3: REGISTER_INTERPRETER("CYBORG-LANG") AS ACTIVE;
    STEP 4: BIND_EXTENSIONS(".fvs", ".cmt");
    STEP 5: SIGNAL "INTERPRETER_READY";
END INTERPRETER_LOADER
