/* FILE: AVIS/VERSION 1/ENGINE/cyborg.engine
   ROLE: CYBORG_ENGINE
   VERSION: 1
*/

BEGIN ENGINE CYBORG_ENGINE_V1
    [ENGINE_META]:
        VERSION: 1;
        PRIMARY_OBJECT: HYPER_MATRIX;
        INTERPRETER: "CYBORG-LANG";

    [ENGINE_INIT]:
        LOAD_SCHEMA("AVIS/VERSION 1/matrix/schema.avis");
        LOAD_DEFS("AVIS/VERSION 1/DEFS/matrix.defs");
        LOAD_INTERPRETER("CYBORG-LANG");

    [ENGINE_OPS]:
        OP INIT_MATRIX(MATRIX_INSTANCE):
            BIND(MATRIX_INSTANCE);
            SET_STATE(READY);

        OP WRITE_CELL(COORD, PAYLOAD):
            VALIDATE_COORD(COORD);
            STORE(COORD, PAYLOAD);

        OP READ_CELL(COORD):
            VALIDATE_COORD(COORD);
            RETURN FETCH(COORD);

        OP AUTOGEN_LAYER(RANGE):
            FOR EACH LAYER IN RANGE:
                GENERATE_DEFAULT_CELL(LAYER);

    [ENGINE_STATUS]:
        STATE: IDLE;
END ENGINE
