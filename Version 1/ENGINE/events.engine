/* FILE: AVIS/VERSION 1/ENGINE/events.engine
   ROLE: EVENT_SYSTEM
   VERSION: 1
*/

BEGIN EVENT_SYSTEM VERSION_1
    [EVENT_META]:
        VERSION: 1;
        ENGINE: "CYBORG_ENGINE_V1";

    [EVENT_TYPES]:
        EVENT_INIT;
        EVENT_MATRIX_WRITE;
        EVENT_MATRIX_READ;
        EVENT_AUTOGEN;
        EVENT_SEARCH_INDEX;
        EVENT_RUNTIME_TICK;

    [EVENT_QUEUE]:
        QUEUE_SIZE: 1024;
        MODE: FIFO;

    [EVENT_DISPATCH]:
        ON EVENT_INIT:
            ENGINE_INIT_MATRIX();

        ON EVENT_MATRIX_WRITE(COORD, PAYLOAD):
            ENGINE.WRITE_CELL(COORD, PAYLOAD);

        ON EVENT_MATRIX_READ(COORD):
            RETURN ENGINE.READ_CELL(COORD);

        ON EVENT_AUTOGEN(RANGE):
            ENGINE.AUTOGEN_LAYER(RANGE);

        ON EVENT_SEARCH_INDEX(FILE):
            SEND FILE TO "AVIS/VERSION 1/SEARCH/index.search";

        ON EVENT_RUNTIME_TICK:
            UPDATE_RUNTIME_STATE();
END EVENT_SYSTEM
