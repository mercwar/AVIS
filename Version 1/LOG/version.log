/* FILE: AVIS/VERSION 1/LOG/version.log
   ROLE: VERSION_LOG
   VERSION: 1
*/

BEGIN LOG VERSION_1
    ON EVENT_INIT:
        WRITE "VERSION 1 INITIALIZED";

    ON EVENT_MATRIX_WRITE:
        WRITE "CELL WRITE EVENT";

    ON EVENT_MATRIX_READ:
        WRITE "CELL READ EVENT";

    ON EVENT_AUTOGEN:
        WRITE "AUTOGEN LAYER EVENT";

    ON EVENT_SEARCH_INDEX:
        WRITE "SEARCH INDEX EVENT";

    ON EVENT_RUNTIME_TICK:
        WRITE "RUNTIME TICK";
END LOG
