/* FILE: AVIS/VERSION 1/SEARCH/index.search
   ROLE: SEARCH_INDEX
   VERSION: 1
*/

BEGIN INDEX VERSION_1_INDEX
    [INDEX_META]:
        VERSION: 1;
        MODE: RECURSIVE_DEEP;

    [INDEX_RULES]:
        ON RECEIVE(FILE):
            EXTRACT_METADATA(FILE);
            STORE_INDEX_ENTRY(FILE.PATH, FILE.META);

    [INDEX_QUERY]:
        QUERY(PATH):
            RETURN LOOKUP(PATH);
END INDEX
