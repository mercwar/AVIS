/* FILE: AVIS/VERSION 1/SEARCH/crawl.search
   ROLE: SEARCH_CRAWLER
   VERSION: 1
*/

BEGIN CRAWL_PROFILE VERSION_1
    ROOT_PATH: "AVIS/VERSION 1/"

    TARGETS:
        INCLUDE "scripts/*.fvs";
        INCLUDE "objects/*.cmt";
        INCLUDE "SCHEMA/*.schema";
        INCLUDE "SCHEMA.AVIS_INTERPRETER.REG";

    RECURSION:
        MODE: TREE_WALK;
        FOLLOW_SYMLINKS: FALSE;

    ON_FILE_DISCOVERED(FILE):
        TAG FILE WITH { VERSION: 1, VISIBILITY: GLOBAL };
        SEND FILE TO "SEARCH/index.search";
END CRAWL_PROFILE
