/* FILE: datalake.graph */
/* PATH: /AVIS-DATALAKE/Constellation/custom/datalake.graph */

/* ------------------------------------------------------------
   AVIS.HEADER
   ROLE: DATALAKE_GRAPH_MAP
   PURPOSE: Defines Datalake’s internal semantic graph for
            Constellation robots.
   AUTHOR: Demon
   NOTES: Mirrors the 6-layer Datalake intelligence stack.
   ------------------------------------------------------------ */

[GRAPH]
NODE:ROOT = /AVIS-DATALAKE/
NODE:L1 = /AVIS-DATALAKE/L1_RAW/
NODE:L2 = /AVIS-DATALAKE/L2_SEMANTIC/
NODE:L3 = /AVIS-DATALAKE/L3_PATTERN/
NODE:L4 = /AVIS-DATALAKE/L4_SYMBOLS/
NODE:L5 = /AVIS-DATALAKE/L5_ALIGNMENT/
NODE:L6 = /AVIS-DATALAKE/L6_INTELLIGENCE/

[LINKS]
ROOT -> L1
L1 -> L2
L2 -> L3
L3 -> L4
L4 -> L5
L5 -> L6
L6 -> ROOT
